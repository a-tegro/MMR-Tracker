{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/scan/*.js":      { "maxDuration": 60,  "includeFiles": "server/newsCache.json" },
    "api/cron/*.js":      { "maxDuration": 300, "includeFiles": "server/newsCache.json" },
    "api/news/*.js":      { "includeFiles": "server/newsCache.json" },
    "api/milestones/*.js":{ "includeFiles": "server/newsCache.json" },
    "api/status.js":      { "includeFiles": "server/newsCache.json" }
  },
  "crons": [
    { "path": "/api/cron/scan-all", "schedule": "0 2 * * 0" }
  ]
}
